.env

# Dependencies and build output
node_modules/
ui/dist/
.wrangler/

# Generated by ui/scripts/generate.mjs at every build.
#
# These are DERIVED from ideas/, exports/, and system/registry.md - the repo is
# their source of truth, and `npm run build` regenerates them before every
# deploy (see ui/package.json). Committing them meant every structural change
# carried ~1500 lines of generated diff, and the copies still never matched the
# deployed ones: the first line of each text edition is a generation timestamp,
# so the checked-in file and the built file differ by construction.
#
# Cost of ignoring them, named honestly: the repo is no longer readable as
# plain text without a build step. `npm run generate --prefix ui` reproduces
# them in one command from a clean checkout.
ui/src/data/estate.json
ui/public/llms.txt
ui/public/llms-full.txt
ui/public/sitemap.xml
